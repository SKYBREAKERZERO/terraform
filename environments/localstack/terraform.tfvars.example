# ============================================================
# Project
# ============================================================

project_name = "aws-enterprise-lab"
environment  = "localstack"


# ============================================================
# LocalStack / AWS
# ============================================================

aws_region          = "ap-northeast-1"
aws_access_key      = "test"
aws_secret_key      = "test"
localstack_endpoint = "http://localhost:4566"


# ============================================================
# VPC
# ============================================================

vpc_cidr = "10.0.0.0/16"


# ============================================================
# Public Subnets
# ============================================================

public_subnets = {
  public-a = {
    cidr_block        = "10.0.1.0/24"
    availability_zone = "ap-northeast-1a"
  }

  public-c = {
    cidr_block        = "10.0.2.0/24"
    availability_zone = "ap-northeast-1c"
  }
}


# ============================================================
# Private Application Subnets
# ============================================================

private_app_subnets = {
  app-a = {
    cidr_block        = "10.0.101.0/24"
    availability_zone = "ap-northeast-1a"
  }

  app-c = {
    cidr_block        = "10.0.102.0/24"
    availability_zone = "ap-northeast-1c"
  }
}


# ============================================================
# Private Database Subnets
# ============================================================

private_db_subnets = {
  db-a = {
    cidr_block        = "10.0.201.0/24"
    availability_zone = "ap-northeast-1a"
  }

  db-c = {
    cidr_block        = "10.0.202.0/24"
    availability_zone = "ap-northeast-1c"
  }
}


# ============================================================
# Internet Gateway
# ============================================================

create_internet_gateway = true


# ============================================================
# NAT Gateway
# ============================================================

nat_gateway_mode = "single"


# ============================================================
# Network Protection
# ============================================================

prevent_destroy = false


# ============================================================
# Security
# ============================================================

# LocalStack Docker-backed EC2 compatibility.
# The enterprise application SG is still created and validated
# independently by module.security.
localstack_use_default_security_group = true


# ============================================================
# IAM
# ============================================================

iam_enable_ssm              = true
iam_enable_cloudwatch_agent = true


# ============================================================
# EC2
# ============================================================

ec2_ami_id        = "ami-df5de72bdb3b"
ec2_instance_type = "t3.micro"

ec2_enable_detailed_monitoring = false
ec2_ebs_optimized              = false

ec2_root_volume_size      = 20
ec2_root_volume_type      = "gp3"
ec2_kms_key_id            = null
ec2_delete_on_termination = true

ec2_metadata_hop_limit = 1